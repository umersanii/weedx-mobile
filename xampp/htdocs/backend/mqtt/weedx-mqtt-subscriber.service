[Unit]
Description=WeedX MQTT Subscriber
After=network.target mysql.service mosquitto.service
Wants=mysql.service mosquitto.service

[Service]
Type=simple
ExecStart=/usr/bin/php /home/sani/c0d3/weedx-mobile/xampp/htdocs/backend/mqtt/subscriber.php
Restart=always
